# ==========================================================
# AI Safety & Evaluation Gateway - Environment Variables
# ==========================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Note: If GROQ_API_KEY is left empty, the Gateway operates
# in offline Mock Mode, so you can test everything for free!
# ==========================================================

# --- Gateway Server ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# CORS Allowed Origins
# Development default is ["*"] (open). For production, list your frontend domain(s):
# ALLOWED_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]
ALLOWED_ORIGINS=["*"]

# --- LLM Provider (Groq / OpenAI compatible) ---
# Get free key from: https://console.groq.com/
GROQ_API_KEY=
PRIMARY_MODEL=llama-3.1-8b-instant
FALLBACK_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.2

# --- Medical Q&A Dataset ---
MEDQUAD_CSV_PATH=./data/sample_medquad.csv

# --- Observability (Optional) ---
# Optional: set this to allow detailed recent traces from /metrics via X-API-Key.
# Without this key, /metrics returns aggregate metrics only.
METRICS_API_KEY=

# Reserved for future LangSmith tracing; not currently wired into the app.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=medical-safety-gateway

# --- Twilio WhatsApp Integration (Optional) ---
# If TWILIO_AUTH_TOKEN is set, /webhook verifies the X-Twilio-Signature header.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
